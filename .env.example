# Optional live providers. The app works in deterministic demo mode without them.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ADAPTION_API_KEY=
SIGNALLOCK_PROVIDER=heuristic
SIGNALLOCK_MAX_ALERT_CHARS=12000

# Required for public live-provider deployments so authority tokens survive restarts/workers.
SIGNALLOCK_AUTHORITY_SECRET=
# Optional public demo access control. When set, the browser authenticates via /api/live-session.
SIGNALLOCK_LIVE_PROVIDER_TOKEN=
# Required to trust a packaged (non-Git) release during V7 sealing/preflight.
SIGNALLOCK_TRUSTED_RUNTIME_SHA256=
